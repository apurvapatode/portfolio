{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    // DOM for the Web APIs this function runs on — Request/Response/fetch and
    // console are all provided by Vercel's runtime. Typing them from the DOM lib
    // avoids depending on @types/node resolving on the build box.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Deliberately empty: the one Node global this project uses (`process.env`)
    // is declared inline in api/enquiry.ts. Depending on @types/node resolving
    // here broke the Vercel build while passing locally.
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["api"]
}
